# Copia este archivo a .env.local antes de ejecutar la app.
#
# URL base de la API de MyCoins (mycoins-listo). Depende de dónde corre el backend
# y sobre qué destino se ejecuta la app — ver README.md, sección "Direccionamiento
# al backend":
#
#   - Navegador (ionic serve, sin Capacitor):      http://localhost:3000
#   - Emulador Android (AVD):                       http://10.0.2.2:3000
#   - Dispositivo físico Android/iOS (misma red Wi-Fi que el backend):
#                                                    http://<IP-LAN-de-tu-PC>:3000
#
VITE_API_BASE_URL=http://10.0.2.2:3000
